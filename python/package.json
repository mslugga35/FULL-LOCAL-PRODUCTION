{
  "name": "hetzner-discord-bot-system",
  "version": "2.0.0",
  "description": "Hardened Discord bot system with improved stability and security",
  "main": "ecosystem.config.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.js",
    "stop": "pm2 stop all",
    "restart": "pm2 restart all",
    "logs": "pm2 logs",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint *.js utils/*.js tests/*.js",
    "healthcheck": "node healthcheck.js",
    "watchdog": "node watchdog.js",
    "ocr": "node --expose-gc ocr_processor_improved.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.62.0",
    "@google-cloud/vision": "^5.3.3",
    "axios": "^1.12.2",
    "bottleneck": "^2.19.5",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "form-data": "^4.0.4",
    "node-fetch": "^2.7.0",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "telegram",
    "forwarder",
    "ocr"
  ],
  "author": "",
  "license": "MIT"
}
